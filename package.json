{
  "name": "nemodoc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-pdf-assets.mjs",
    "format": "prettier --write src server scripts tests *.ts *.json *.md",
    "dev": "node scripts/prepare-pdf-assets.mjs && concurrently -k -n api,web -c green,blue \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "node scripts/prepare-pdf-assets.mjs && tsc -b && vite build",
    "start": "tsx server/index.ts",
    "check": "tsc -b",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.1.12"
  },
  "overrides": {
    "katex": "$katex",
    "concurrently": {
      "shell-quote": "^1.11.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
