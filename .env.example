# Get a key from https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
PORT=3001
# Runtime agent overview: run NemoDoc on this NemoClaw host with its CLI on PATH.
# Must name the same sandbox as the configured OpenClaw gateway (default: nemodoc).
NEMODOC_NEMOCLAW_SANDBOX=nemodoc
# Docker Compose database passwords: use long random URL-safe values.
POSTGRES_PASSWORD=
AGENT_READ_PASSWORD=
# PostgreSQL 17 uses a named volume and loopback port 55433. Keep the separate
# integration-test cluster on 55432. For the host-run app, set both URLs:
# DATABASE_URL=postgresql://nemodoc:password@127.0.0.1:55433/nemodoc
# AGENT_READ_DATABASE_URL=postgresql://agent_reader:password@127.0.0.1:55433/nemodoc
# Nebius Token Factory (takes priority when a nonempty key is set).
# Saved app Settings take precedence over environment defaults.
# Choose an NVIDIA model available to your account via Settings > model catalog.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# For a locally running NVIDIA NIM, use its /v1 URL and served model ID.
# NVIDIA_BASE_URL=http://127.0.0.1:8000/v1
# NVIDIA_MODEL=your-served-nemotron-model-id
